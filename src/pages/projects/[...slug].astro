---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import site from "@/data/site.json";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: d.title,
  description: d.summary,
  author: { "@type": "Person", name: site.name, url: site.url },
  programmingLanguage: d.tools,
  ...(d.repo ? { codeRepository: d.repo } : {}),
};
---

<Base title={d.title} description={d.summary} type="article">
  <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

  <a href="/projects" class="text-xs text-muted hover:text-accent">← Work</a>

  <header class="mt-4 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">{d.title}</h1>
    <p class="mt-3 text-lg leading-relaxed text-ink-2">{d.summary}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-y border-line py-4 text-sm">
      {
        (d.started || d.ended) && (
          <div>
            <dt class="text-xs text-muted">When</dt>
            <dd class="mt-0.5 font-mono text-ink-2">
              {d.started}
              {d.ended ? ` – ${d.ended}` : d.status === "active" ? " – present" : ""}
            </dd>
          </div>
        )
      }
      {
        d.metrics.length > 0 && (
          <div>
            <dt class="text-xs text-muted">Result</dt>
            <dd class="mt-0.5 font-mono text-good">{d.metrics.join(" · ")}</dd>
          </div>
        )
      }
      {
        d.repo && (
          <div>
            <dt class="text-xs text-muted">Source</dt>
            <dd class="mt-0.5">
              <a href={d.repo} target="_blank" rel="noopener" class="text-accent hover:underline">
                {d.repo.replace("https://github.com/", "")} ↗
              </a>
            </dd>
          </div>
        )
      }
    </dl>

    {
      d.tools.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {d.tools.map((t) => (
            <li class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
              {t}
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <div class="prose mt-10">
    <Content />
  </div>
</Base>
