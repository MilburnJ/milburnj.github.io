---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const all = (await getCollection("projects")).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    (b.data.started ?? "").localeCompare(a.data.started ?? "")
);
const featured = all.filter((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
---

<Base
  title="Work"
  description="Selected engineering work — production ML pipelines, computer-vision research, and systems projects."
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Work</h1>
    <p class="mt-3 leading-relaxed text-ink-2">
      A few things worth reading about, then everything else. Employer work is described at the
      level of the problem and the approach — no internal names, no customer data.
    </p>
  </header>

  {
    featured.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-5 text-sm font-semibold tracking-tight text-muted">Selected</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {featured.map((p) => (
            <ProjectCard project={p} featured />
          ))}
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-5 text-sm font-semibold tracking-tight text-muted">Also</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {rest.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>
