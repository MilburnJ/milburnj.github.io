---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Base title="Writing" description="Notes on machine learning, engineering, and shipping things.">
  <header class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Writing</h1>
    <p class="mt-3 leading-relaxed text-ink-2">
      Occasional notes on what I've built and what broke along the way.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <p class="mt-10 rounded-card border border-dashed border-edge px-4 py-10 text-center text-sm text-muted">
        Nothing published yet.
      </p>
    ) : (
      <ul class="mt-10 flex flex-col divide-y divide-line border-y border-line">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}`} class="group flex flex-col gap-1.5 py-5">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-medium text-ink group-hover:text-accent">{post.data.title}</h2>
                <span class="shrink-0 font-mono text-xs text-muted">{post.data.date}</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-2">{post.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
