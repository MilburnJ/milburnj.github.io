---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import site from "@/data/site.json";
import about from "@/data/about.json";

// The portrait is synced from the vault. Glob-import it so astro:assets can optimize it,
// while tolerating its absence - a vault without an avatar must still build.
const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/avatar.{webp,jpg,jpeg,png}",
  { eager: true }
);
const avatar = Object.values(avatars)[0]?.default;
---

<Base title="About" description={site.description}>
  <div class="flex flex-col-reverse gap-8 sm:flex-row-reverse sm:items-start sm:gap-10">
    {
      avatar && (
        <figure class="shrink-0">
          <Image
            src={avatar}
            alt={about.avatar_alt ?? site.name}
            width={192}
            height={192}
            densities={[1, 2]}
            loading="eager"
            class="h-36 w-36 rounded-2xl border border-line object-cover sm:h-48 sm:w-48"
          />
          <figcaption class="mt-2.5 font-mono text-[11px] text-muted">{site.location}</figcaption>
        </figure>
      )
    }

    <div class="min-w-0 flex-1">
      <h1 class="text-3xl font-semibold tracking-tight text-ink">About</h1>
      <div class="prose mt-6">
        <Fragment set:html={about.html} />
      </div>
    </div>
  </div>

  {
    about.now.length > 0 && (
      <section class="mt-14 max-w-2xl">
        <h2 class="text-sm font-semibold tracking-tight text-ink">Right now</h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {about.now.map((item: string) => (
            <li class="flex gap-3 text-sm leading-relaxed text-ink-2">
              <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden />
              <span set:html={item} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-14 max-w-2xl">
    <h2 class="text-sm font-semibold tracking-tight text-ink">Get in touch</h2>
    <p class="mt-3 text-sm leading-relaxed text-ink-2">
      Email is best: <a class="text-accent hover:underline" href={`mailto:${site.email}`}>{site.email}</a>.
      I'm also on <a class="text-accent hover:underline" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      and <a class="text-accent hover:underline" href={site.links.github} target="_blank" rel="noopener">GitHub</a>.
    </p>

    <form
      class="mt-6 flex max-w-md flex-col gap-3"
      action={`https://formspree.io/f/${site.formspree_id}`}
      method="POST"
    >
      <label class="flex flex-col gap-1.5">
        <span class="text-xs text-muted">Your email</span>
        <input
          type="email"
          name="email"
          required
          class="rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink outline-none focus:border-accent"
        />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="text-xs text-muted">Message</span>
        <textarea
          name="message"
          rows="4"
          required
          class="rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink outline-none focus:border-accent"
        ></textarea>
      </label>
      <button
        type="submit"
        class="self-start rounded-lg bg-accent px-4 py-2 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
      >
        Send
      </button>
    </form>
  </section>
</Base>
