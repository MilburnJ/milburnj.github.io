---
import Base from "@/layouts/Base.astro";
---

<Base title="Not found" noIndex>
  <div class="py-20 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-ink">That page doesn't exist</h1>
    <p class="mt-3 text-sm text-ink-2">It may have moved when I rebuilt this site.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg border border-edge px-4 py-2 text-sm text-ink transition-colors hover:border-ink"
    >
      Back home
    </a>
  </div>
</Base>
