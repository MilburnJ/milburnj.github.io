---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const d = project.data;
const years = d.ended && d.ended.slice(0, 4) !== d.started?.slice(0, 4)
  ? `${d.started?.slice(0, 4)}–${d.ended.slice(0, 4)}`
  : (d.started?.slice(0, 4) ?? "");
---

<article
  class:list={[
    "group relative flex flex-col rounded-card border border-line bg-surface transition-colors hover:border-edge",
    featured ? "p-6" : "p-5",
  ]}
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class:list={["font-semibold tracking-tight text-ink", featured ? "text-lg" : "text-base"]}>
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {d.title}
      </a>
    </h3>
    {years && <span class="shrink-0 font-mono text-xs text-muted">{years}</span>}
  </div>

  <p class="mt-2 text-sm leading-relaxed text-ink-2">{d.summary}</p>

  {
    d.metrics.length > 0 && (
      <p class="mt-3 font-mono text-xs text-good">{d.metrics.join("  ·  ")}</p>
    )
  }

  {
    d.tools.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {d.tools.slice(0, featured ? 8 : 5).map((t) => (
          <li class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">
            {t}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex items-center gap-4 pt-4 text-xs">
    <span class="text-accent">read →</span>
    {
      d.repo && (
        <a
          href={d.repo}
          target="_blank"
          rel="noopener"
          class="relative z-10 text-muted hover:text-ink"
        >
          source ↗
        </a>
      )
    }
    {d.writeupOnly && <span class="text-muted">write-up · private repo</span>}
  </div>
</article>
